# Copia este archivo como .env y agrega tu clave de Gemini.
# Si los tres modelos fallan o no hay API key, se usa el modo extractivo.
GEMINI_API_KEY=

# Modelo principal y dos respaldos (se intentan en este orden).
GEMINI_PRIMARY_MODEL=gemini-4-neon
GEMINI_BACKUP_MODEL_1=gemini-4-hydrogen
GEMINI_BACKUP_MODEL_2=gemini-4-carbon

# Umbral de similitud RAG y secreto de sesión JWT.
UMBRAL=0.40
JWT_SECRET=cambia-esta-clave-por-un-secreto-largo-y-aleatorio
